LHM_ROOT=../LHM-plusplus
MODEL_NAME=LHMPP-700M-PixelShuffle
MODEL_PATH=
MOCK_MODE=true
CORS_ORIGINS=http://localhost:3000
API_PORT=8000

# 启动时预加载 LHM++ 模型（动作驱动）；false 则首次 animate 请求时再加载
PRELOAD_MODEL=true

# ---------------------------------------------------------------------------
# 推理显存 / 测试模式（OOM 或本地小 GPU 时调整；正式出片建议全部默认关闭）
# ---------------------------------------------------------------------------
#
# INFER_LOW_MEMORY — 一键低显存预设（true/false）
#   false：正常质量。参考图 Pad 后最大高度 840px，最多 8 视角，动画 40 帧/批，体素点用模型默认 160000。
#   true ：测试/小显存。自动变为：560px、最多 4 视角、动画 8 帧/批、体素点降至 80000（若 prior 缓存存在）。
#   设为 true 后，下方 INFER_*=0 的项会跟随该预设；非 0 则覆盖预设。
#
INFER_LOW_MEMORY=false

# INFER_MAX_IMAGE_SIZE — 参考图归一化后的最大高度（像素，PadRatioWithScale）
#   0   ：自动。INFER_LOW_MEMORY=false → 840；true → 560。
#   >0  ：强制使用该高度（如 448、392）。越小越省显存，细节略降。
#   影响：3D 重建 + 动作驱动（DINOv2 输入尺寸）。
#
INFER_MAX_IMAGE_SIZE=0

# INFER_REF_VIEW_MAX — 单次推理使用的参考视角数量上限
#   0   ：自动。INFER_LOW_MEMORY=false → 8（与 max_ref_images 一致）；true → 4。
#   >0  ：强制上限（如 2、1）。上传多张图时会均匀采样，不超过此值。1 最省显存。
#   影响：3D 重建 + 动作驱动。前端表单的 ref_view 也会被此值截断。
#
INFER_REF_VIEW_MAX=0

# INFER_ANIM_BATCH_SIZE — 动作驱动渲染时每批处理的视频帧数
#   0   ：自动。INFER_LOW_MEMORY=false → 40；true → 8。
#   >0  ：强制 batch（如 4）。仅影响「动作视频/摄像头驱动」阶段，不影响 3D 重建 PLY 导出。
#
INFER_ANIM_BATCH_SIZE=0

# INFER_DENSE_SAMPLE_PTS — 体素 / query 采样点数量（spconv 稀疏卷积，显存大户）
#   0   ：自动。INFER_LOW_MEMORY=false → 不覆盖，用 checkpoint 默认（PixelShuffle 多为 160000）。
#         INFER_LOW_MEMORY=true  → 尝试降至 80000（需 LHM_ROOT/pretrained_models/dense_sample_points/1_80000.ply 等缓存）。
#   >0  ：强制上限（如 40000）。HRM 会选用 ≤ 该值且已下载的最大 prior PLY（40000/80000/160000）。
#   影响：3D 重建 + 动作驱动。报错含 cumm/spconv/TensorStorage OOM 时优先调此项。
#
INFER_DENSE_SAMPLE_PTS=0

# Blender 可执行文件路径（导出蒙皮 FBX 时使用；留空则自动查找 PATH 中的 blender）
# Linux 示例: BLENDER_EXECUTABLE=/usr/bin/blender
# FBX 导出还需 numpy（apt 版 Blender 未内置）: sudo apt install -y python3-numpy
BLENDER_EXECUTABLE=

# FBX：从 3DGS 烘焙 UV diffuse 并嵌入 FBX；
FBX_BAKE_TEXTURE=true
# 贴图分辨率
FBX_TEXTURE_SIZE=2048
# 细分 0=低模(~2万面) 1≈4×面 2≈16×面
FBX_SUBDIVISION_LEVELS=1

# 可选：SMPL-X 官方 smplx_uv.obj（LHM human_model_files 无 UV 时使用）
# SMPLX_UV_OBJ=/path/to/smplx_uv.obj
# 或复制到 api/assets/smplx_uv.obj
SMPLX_UV_OBJ=
